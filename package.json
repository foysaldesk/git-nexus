{
  "name": "git-nexus-desktop",
  "version": "1.0.2",
  "description": "Modern Graphical Git Repository Manager and Terminal built with Electron",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node test-git-service.js",
    "generate:icons": "electron scripts/generate-icons.js",
    "generate:icons:terminal": "electron scripts/generate-terminal-icons.js",
    "register:context-menu": "node scripts/setup-context-menu.js",
    "unregister:context-menu": "node scripts/remove-context-menu.js",
    "fix:shortcut": "node scripts/fix-desktop-shortcut.js",
    "build:win": "electron-builder --win",
    "build:win:portable": "electron-builder --win portable",
    "build:all": "electron-builder -mwl",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.gitnexus.desktop",
    "productName": "Git Nexus",
    "copyright": "Copyright © 2026 Git Nexus",
    "asar": true,
    "asarUnpack": [
      "assets/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!scripts/**/*",
      "!test-git-service.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Git Nexus",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icons",
      "category": "Development"
    }
  },
  "keywords": [
    "git",
    "electron",
    "git-gui",
    "git-manager",
    "terminal"
  ],
  "author": "DevTune",
  "license": "MIT",
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "simple-git": "^3.27.0"
  },
  "devDependencies": {
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8"
  }
}
